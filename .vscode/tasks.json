{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chatwork Clipper: Dev Gateway",
      "type": "shell",
      "command": "npm run clipper:gateway",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "chatwork-clipper-gateway",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "clipper:gateway",
          "endsPattern": "Chatwork Clipper bookmarklet:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Chatwork Clipper: Test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
